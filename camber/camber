  <main id="main">

    <!-- =============================================================== HERO
         Three giant words with a rotated word beside each. The car drives
         in from the right and stops on the floor shadow. -->
    <section class="hero" id="top" data-scene="hero">
      <!-- Background stack, back to front: blueprint grid (masked), two skewed
           speed bands, a giant outlined wordmark, the racing line, the glow.
           All static paint; GSAP only translates them. -->
      <div class="hero__bg" aria-hidden="true">
        <span class="hero__grid"></span>
        <span class="hero__band hero__band--1"></span>
        <span class="hero__band hero__band--2"></span>
        <p class="hero__mark">CAMBER</p>
        <svg class="hero__arc" viewbox="0 0 1440 900" preserveaspectratio="none"><path pathlength="1" d="M540 980C760 700 900 640 1100 560S1400 430 1520 380"></path></svg>
        <span class="hero__glow"></span>
      </div>
      <div class="hero__inner">
        <h1 class="hero__title">
          <span class="w" data-w="0"><span class="w__mask"><span class="w__big">Build</span></span><span class="w__side"><span>parts</span></span></span>
          <span class="w" data-w="1"><span class="w__mask"><span class="w__big">Tune</span></span><span class="w__side"><span>power</span></span></span>
          <span class="w" data-w="2"><span class="w__mask"><span class="w__big">Drive</span></span><span class="w__side"><span>faster</span></span></span>
        </h1>

        <p class="hero__lede">Wheels, brakes, suspension and track‑day gear — picked for your exact car, fitted right, at your door in 48 hours.</p>

        <div class="hero__cta">
          <a class="btn btn--ink" href="#parts" data-magnetic=""><span>Shop the catalogue</span></a>
          <a class="hero__link" href="#quality">Why Camber <span aria-hidden="true">↓</span></a>
        </div>

        <!-- The vehicles. Stage = the scroll-scrub layer; each slot = the
             drive-out / drive-in layer (class switch); its img = the pointer
             parallax layer (quickTo). Never the same element. -->
        <div class="hero__stage">
          <div class="hero__floor" aria-hidden="true"></div>
          <figure class="hero__slot is-on" data-slot="0">
            <img src="photos/camber/hero-car.webp" alt="A gunmetal grey sports coupe on orange brake calipers, seen from the front three-quarter" width="1380" height="690" data-ph="" fetchpriority="high">
            <ul class="callouts" aria-label="Fitted on this vehicle">
              <li class="callout" style="--x:16%; --y:54%"><i></i><span>Matrix LED · OEM plug</span></li>
              <li class="callout" style="--x:34%; --y:71%"><i></i><span>6‑piston · 380 mm discs</span></li>
              <li class="callout callout--left" style="--x:82%; --y:66%"><i></i><span>Forged 19″ monoblock · 8.2 kg</span></li>
            </ul>
          </figure>
          <figure class="hero__slot" data-slot="1">
            <img src="photos/camber/hero-motorcycle.webp" alt="A gunmetal naked sports motorcycle with an orange frame, facing left" width="1380" height="690" data-ph="" loading="lazy" decoding="async">
            <ul class="callouts" aria-label="Fitted on this vehicle">
              <li class="callout callout--left" style="--x:29%; --y:40%"><i></i><span>LED projector · plug‑in</span></li>
              <li class="callout" style="--x:33%; --y:74%"><i></i><span>Radial 4‑piston · 320 mm</span></li>
              <li class="callout" style="--x:57%; --y:51%"><i></i><span>Monoshock · 30‑way adjustable</span></li>
            </ul>
          </figure>
          <figure class="hero__slot" data-slot="2">
            <img src="photos/camber/hero-pickup.webp" alt="A lifted gunmetal double-cab pickup on all-terrain tyres, facing left" width="1380" height="690" data-ph="" loading="lazy" decoding="async">
            <ul class="callouts" aria-label="Fitted on this vehicle">
              <li class="callout" style="--x:28%; --y:44%"><i></i><span>Slim LED · OEM harness</span></li>
              <li class="callout" style="--x:36%; --y:72%"><i></i><span>2.5″ lift · remote‑res dampers</span></li>
              <li class="callout callout--left" style="--x:85%; --y:76%"><i></i><span>35″ all‑terrains · 17″ beadlocks</span></li>
            </ul>
          </figure>
          <figure class="hero__slot" data-slot="3">
            <img src="photos/camber/hero-electric.webp" alt="A gunmetal electric fastback with a full-width light bar, facing left" width="1380" height="690" data-ph="" loading="lazy" decoding="async">
            <ul class="callouts" aria-label="Fitted on this vehicle">
              <li class="callout" style="--x:15%; --y:60%"><i></i><span>Full‑width LED bar</span></li>
              <li class="callout" style="--x:44%; --y:78%"><i></i><span>Regen 4‑piston · 380 mm</span></li>
              <li class="callout callout--left" style="--x:84%; --y:78%"><i></i><span>Aero 21″ turbines · 9.1 kg</span></li>
            </ul>
          </figure>
          <figure class="hero__slot" data-slot="4">
            <img src="photos/camber/hero-scooter.webp" alt="A gunmetal electric maxi-scooter with orange accents, facing left" width="1380" height="690" data-ph="" loading="lazy" decoding="async">
            <ul class="callouts" aria-label="Fitted on this vehicle">
              <li class="callout callout--left" style="--x:33%; --y:50%"><i></i><span>LED halo · 12 V</span></li>
              <li class="callout" style="--x:35%; --y:74%"><i></i><span>ABS twin‑piston · 260 mm</span></li>
              <li class="callout" style="--x:64%; --y:66%"><i></i><span>Rear monoshock · 5‑way</span></li>
            </ul>
          </figure>
        </div>

        <!-- The hero's control: pick a vehicle type and the stage swaps vehicles. -->
        <div class="cats" role="tablist" aria-label="Vehicle type">
        <span class="cats__thumb" aria-hidden="true"></span>
        <button class="cat is-on" role="tab" aria-selected="true" data-cat="coupes">
          <svg viewbox="0 0 48 48" aria-hidden="true"><path pathlength="1" d="M6 28h36M8 28v-4l5-8h18l9 8v4M13 16l-2 8M16 34a3 3 0 1 0 0 .1M34 34a3 3 0 1 0 0 .1M19 34h12M8 34h5M37 34h3"></path></svg>
          <span>Coupes</span>
        </button>
        <button class="cat" role="tab" aria-selected="false" data-cat="motorcycles">
          <svg viewbox="0 0 48 48" aria-hidden="true"><path pathlength="1" d="M11 32a5 5 0 1 0 0 .1M37 32a5 5 0 1 0 0 .1M11 32l7-10h8l4-6h5M26 22l6 10M18 22l-5-6h-4M31 16l4 1"></path></svg>
          <span>Motorcycles</span>
        </button>
        <button class="cat" role="tab" aria-selected="false" data-cat="pickups">
          <svg viewbox="0 0 48 48" aria-hidden="true"><path pathlength="1" d="M5 30V16h17l6 8h15v6M5 30h7M17 30h14M36 30h7M14 34a3 3 0 1 0 0 .1M39 34a3 3 0 1 0 0 .1M22 16v8"></path></svg>
          <span>Pickups</span>
        </button>
        <button class="cat" role="tab" aria-selected="false" data-cat="electric">
          <svg viewbox="0 0 48 48" aria-hidden="true"><path pathlength="1" d="M6 30h36M8 30v-5l6-8h20l6 8v5M15 35a3 3 0 1 0 0 .1M33 35a3 3 0 1 0 0 .1M26 17l-4 6h5l-4 6"></path></svg>
          <span>Electric</span>
        </button>
        <button class="cat" role="tab" aria-selected="false" data-cat="scooters">
          <svg viewbox="0 0 48 48" aria-hidden="true"><path pathlength="1" d="M10 32a4 4 0 1 0 0 .1M38 32a4 4 0 1 0 0 .1M14 32h20M34 32l-4-16h-4M12 24h8l-4 8"></path></svg>
          <span>Scooters</span>
        </button>
        </div>
      </div>
    </section>

    <!-- ============================================================== BUILD
         Scroll-scrubbed film: scroll position IS the frame. 192 stills drawn to
         a canvas (no video seeking, so it is exact both ways). A focus frame
         tracks the caliper, widens to the wheel, then opens to the whole car.
         Card (exit scale) > frame (entry scale) > canvas · focus · copy. -->
    <section class="build" id="build" data-scene="build" aria-label="How a Camber build comes together">
      <div class="build__stage">
        <div class="build__card">
          <div class="build__frame">
            <img class="build__poster" src="photos/camber/build.jpg" alt="" width="1280" height="720" data-end="/camber/photos/camber/build-end.jpg" decoding="async">
            <canvas class="build__canvas" aria-hidden="true"></canvas>
            <div class="build__wash" aria-hidden="true"></div>

            <div class="focus" aria-hidden="true">
              <i class="focus__c" data-c="tl"></i><i class="focus__c" data-c="tr"></i><i class="focus__c" data-c="bl"></i><i class="focus__c" data-c="br"></i>
              <span class="focus__tag"><i></i><span class="focus__label"><span data-tag="">Caliper · 6‑piston</span><span data-tag="">Forged 19″ · 8.2 kg</span></span></span>
            </div>

            <div class="build__beats">
              <article class="beat" data-beat="">
                <p class="beat__no" data-fade=""><span>01</span>Brakes</p>
                <h2 class="h-display h-display--light beat__title" data-split=""><span class="beat__line"><span>Stop</span></span><span class="beat__line"><span>shorter.</span></span></h2>
                <div class="beat__row" data-fade="">
                  <p class="beat__stat"><b><span data-to="380">380</span><small>mm</small></b><span>disc diameter</span></p>
                  <p class="beat__lede">Six‑piston calipers that bolt straight on. No cutting, fitted the same day.</p>
                </div>
              </article>
              <article class="beat" data-beat="">
                <p class="beat__no" data-fade=""><span>02</span>Wheels</p>
                <h2 class="h-display h-display--light beat__title" data-split=""><span class="beat__line"><span>Lighter</span></span><span class="beat__line"><span>corners.</span></span></h2>
                <div class="beat__row" data-fade="">
                  <p class="beat__stat"><b><span data-to="8.2" data-dp="1">8.2</span><small>kg</small></b><span>per forged wheel</span></p>
                  <p class="beat__lede">Forged 19″ monoblocks — less unsprung mass for the dampers to fight.</p>
                </div>
              </article>
              <article class="beat" data-beat="">
                <p class="beat__no" data-fade=""><span>03</span>Fitment</p>
                <h2 class="h-display h-display--light beat__title" data-split=""><span class="beat__line"><span>Fitted</span></span><span class="beat__line"><span>right.</span></span></h2>
                <div class="beat__row" data-fade="">
                  <p class="beat__stat"><b><span data-to="100">100</span><small>%</small></b><span>VIN‑checked</span></p>
                  <p class="beat__lede">Every part is matched to your VIN before it ships. Wrong part? We pay the return.</p>
                </div>
                <a class="btn btn--accent beat__btn" href="#parts" data-fade="" data-magnetic=""><span>Shop the catalogue</span></a>
              </article>
            </div>

            <nav class="chapters" aria-label="Build chapters">
              <button class="chapter" type="button" data-chapter="0"><span>01</span>Brakes<i><b></b></i></button>
              <button class="chapter" type="button" data-chapter="1"><span>02</span>Wheels<i><b></b></i></button>
              <button class="chapter" type="button" data-chapter="2"><span>03</span>Fitment<i><b></b></i></button>
            </nav>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================== FACTS -->
    <section class="facts" aria-label="Camber in numbers">
      <ul class="facts__row">
        <li class="fact"><b><span data-count="12400" data-format="comma">0</span>+</b><span>parts in stock</span></li>
        <li class="fact"><b><span data-count="48">0</span>h</b><span>dispatch, everywhere</span></li>
        <li class="fact"><b><span data-count="30">0</span>d</b><span>no‑questions returns</span></li>
      </ul>
    </section>

    <!-- ============================================================ MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__row">
        <span>Free shipping over $150</span><span>30‑day returns</span><span>OEM‑grade fitment</span><span>48h dispatch</span><span>Real humans on support</span><span>Fitment guaranteed</span>
      </div>
    </div>

    <!-- ============================================================ QUALITY
         The wheel spins with the scroll; four promises sit around it. -->
    <section class="quality" id="quality" data-scene="quality">
      <p class="quality__mark" aria-hidden="true">CAMBER</p>
      <div class="sec-head sec-head--center">
        <p class="eyebrow" data-reveal="">Why Camber</p>
        <h2 class="h-display" data-reveal="">Engineered<br>to outlast</h2>
      </div>
      <div class="quality__grid">
        <div class="promise promise--l" data-side="l">
          <h3>Largest catalogue of fitted parts</h3>
          <p>Every listing is matched to a make, model and year before it goes live.</p>
        </div>
        <div class="promise promise--l" data-side="l">
          <h3>Specialists on the line, 7 days</h3>
          <p>Fitters, not scripts. Send a photo of the part and get an answer.</p>
        </div>
        <figure class="wheel ph">
          <!-- A machined dial behind the wheel: three rings and a tick ring, counter-rotating with the scroll. -->
          <svg class="quality__dial" viewbox="0 0 600 600" aria-hidden="true">
            <circle cx="300" cy="300" r="292"></circle>
            <circle cx="300" cy="300" r="268" stroke-dasharray="2 26.07"></circle>
            <circle cx="300" cy="300" r="238" stroke-dasharray="6 18"></circle>
            <circle class="quality__dial-seg" cx="300" cy="300" r="292" stroke-dasharray="180 1655"></circle>
          </svg>
          <img class="wheel__img" src="photos/camber/wheel.webp" alt="A forged ten-spoke alloy wheel in satin gunmetal, straight on" width="1200" height="1200" loading="lazy" decoding="async" data-ph="">
          <figcaption class="sr">A forged alloy wheel</figcaption>
        </figure>
        <div class="promise promise--r" data-side="r">
          <h3>Every part load‑tested</h3>
          <p>Wheels are JWL‑rated, brakes are dyno‑checked, and bad batches go back.</p>
        </div>
        <div class="promise promise--r" data-side="r">
          <h3>At your door in 48 hours</h3>
          <p>Stocked in three warehouses. Order before noon and it leaves the same day.</p>
        </div>
      </div>
    </section>

    <!-- ============================================================= BRANDS -->
    <section class="brands" id="brands" data-scene="brands">
      <div class="sec-head sec-head--center">
        <p class="eyebrow" data-reveal="">Spares for</p>
        <h2 class="h-display" data-reveal="">Marques we keep<br>on the road</h2>
      </div>
