.lang-switch{position:relative;display:flex;align-items:center;flex:0 0 auto}
.lang-switch__trigger{height:42px;min-width:76px;padding:0 11px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--c-line-2);border-radius:99px;background:var(--c-card);font:700 12px/1 var(--font-body);letter-spacing:.06em;transition:background .2s,border-color .2s}
.lang-switch__trigger:hover,.lang-switch.is-open .lang-switch__trigger{background:var(--c-bg-2);border-color:var(--c-ink)}
.lang-switch__trigger>svg:first-child{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round}
.lang-switch__chevron{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .2s}
.lang-switch.is-open .lang-switch__chevron{transform:rotate(180deg)}
.lang-switch__menu{position:absolute;z-index:300;top:calc(100% + 10px);right:0;width:190px;padding:6px;background:var(--c-card);border:1px solid var(--c-line-2);border-radius:14px;box-shadow:0 18px 45px #10181424}
.lang-switch__menu[hidden]{display:none}
.lang-switch__option{width:100%;min-height:42px;padding:0 10px;display:flex;align-items:center;gap:10px;text-align:left;border-radius:9px;font:600 13px/1.2 var(--font-body);color:var(--c-ink);transition:background .2s}
.lang-switch__option:hover,.lang-switch__option.is-active{background:var(--c-bg-2)}
.lang-flag{width:22px;height:15px;flex:0 0 auto;border-radius:2px;box-shadow:0 0 0 1px #10181420}
.lang-switch__code{margin-left:auto;color:var(--c-dim);font-size:10px;letter-spacing:.1em}
html[lang="ar"] body{direction:rtl}
html[lang="ar"] .nav__links,html[lang="ar"] .nav__icons,html[lang="ar"] .hero__cta,html[lang="ar"] .promo__ctl{direction:rtl}
html[lang="ar"] .lang-switch__menu{right:auto;left:0}
html[lang="ar"] .lang-switch__option{text-align:right}
html[lang="ar"] .lang-switch__code{margin-left:0;margin-right:auto}
html[lang="ar"] .search{direction:rtl;padding:0 16px 0 6px}
html[lang="ar"] .search input{text-align:right}
html[lang="ar"] .footer__grid,html[lang="ar"] .footer__base{direction:rtl}
@media(max-width:820px){.lang-switch__trigger{min-width:68px;height:40px;padding:0 9px}.nav{gap:10px}}
</style>
